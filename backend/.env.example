# NR-IMS Backend - for running OUTSIDE Docker (make dev-backend). Placeholders only.
# Inside Docker these come from deploy/docker-compose.yml, NOT from this file.
NRIMS_ENV=development
NRIMS_DATA_PROVIDER=simulator
NRIMS_LOG_LEVEL=INFO

NRIMS_DATABASE_URL=postgresql+asyncpg://nrims:change-me@localhost:5432/nrims
NRIMS_VALKEY_URL=redis://:change-me@localhost:6379/0
NRIMS_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

NRIMS_CORS_ORIGINS=["http://localhost:5173"]

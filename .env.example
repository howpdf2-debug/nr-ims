# Copy to .env (or run `make init`, which generates strong values for you).
# Generate each secret with:  openssl rand -hex 24
POSTGRES_PASSWORD=change-me-db-password
VALKEY_PASSWORD=change-me-valkey-password
NRIMS_SECRET_KEY=change-me-openssl-rand-hex-32

NRIMS_ENV=development
NRIMS_DATA_PROVIDER=simulator
NRIMS_DOCS_ENABLED=true
# Used by seed_admin.py only; empty = random password printed once.
# NRIMS_SEED_ADMIN_PASSWORD=  (optional, dev only; empty = random, printed once)
HTTP_PORT=80
POSTGRES_HOST_PORT=5432
